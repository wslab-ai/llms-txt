{
  "name": "@workstarlab/llms-txt",
  "version": "0.1.0",
  "description": "Typed llms.txt generator and validator for websites and documentation portals.",
  "type": "module",
  "license": "MIT",
  "author": "Workstar Lab <hello@workstarlab.com>",
  "homepage": "https://github.com/wslab-ai/llms-txt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wslab-ai/llms-txt.git"
  },
  "bugs": {
    "url": "https://github.com/wslab-ai/llms-txt/issues"
  },
  "keywords": [
    "llms.txt",
    "ai",
    "seo",
    "documentation",
    "generator",
    "validator"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "llms-txt": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
